# Safe defaults for the traditional local-development workflow.
# Compose overrides APP_ENV, DATABASE_PATH and MQTT_HOST inside containers.
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=Industrial Edge Monitor API
APP_VERSION=0.1.0
APP_DESCRIPTION=REST API for Industrial Edge Monitor

DEFAULT_HISTORY_LIMIT=100

DATABASE_PATH=data/telemetry.db
DATABASE_TIMEOUT_SECONDS=30

MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_KEEPALIVE_SECONDS=60
MQTT_CLIENT_ENABLED=false
MQTT_TLS_ENABLED=true
MQTT_CA_CERT_PATH=.local/mqtt-security/ca/ca.crt
MQTT_USERNAME=collector
MQTT_PASSWORD_FILE=.local/mqtt-security/clients/collector.password
MQTT_CLIENT_ID=industrial-edge-collector
MQTT_RECONNECT_MIN_SECONDS=1
MQTT_RECONNECT_MAX_SECONDS=30
MQTT_TOPIC=industrial/telemetry
MQTT_TOPIC_PREFIX=industrial/devices
LEGACY_DEVICE_ID=legacy-device
DEVICE_OFFLINE_TIMEOUT_SECONDS=150

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public browser URL embedded into the Next.js bundle by `npm run build`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Path containing generated local certificates and credentials for Compose.
# Generate it with scripts/generate-mqtt-security.sh; never commit its contents.
MQTT_SECURITY_DIR=./.local/mqtt-security
MQTT_COLLECTOR_USERNAME=collector
MQTT_COLLECTOR_CLIENT_ID=industrial-edge-collector
